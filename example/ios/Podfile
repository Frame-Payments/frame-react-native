# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '17.0'  # Frame-iOS and FrameReactNative require iOS 17
project 'FrameExampleTemp.xcodeproj'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FrameExampleTemp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'FrameExampleTempTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # frame-ios pulls in dynamic frameworks (FingerprintPro, LinkKit, the Prove
    # stack) through SPM. RN's spm_dependency hook attaches those products to the
    # Pods target, and this app target links only libPods-*.a with no embed phase
    # of its own, so nothing ever copies them into the bundle: they build into
    # BUILT_PRODUCTS_DIR and dyld then fails at launch with
    # "Library not loaded: @rpath/<name>.framework/<name>".
    #
    # CocoaPods' generated frameworks script only embeds what CocoaPods manages
    # (PODS_XCFRAMEWORKS_BUILD_DIR), so append the SPM-built ones here. Its
    # install_framework helper already resolves paths against BUILT_PRODUCTS_DIR
    # and handles the code-signing and slice-stripping.
    spm_frameworks = %w[
      FingerprintPro
      LinkKit
      Persona2
      ProveAuth
      ProveBase
      ProveMobileAuth
      DeviceAuth
    ]
    frameworks_script = File.join(
      installer.sandbox.root, 'Target Support Files',
      'Pods-FrameExampleTemp', 'Pods-FrameExampleTemp-frameworks.sh'
    )
    if File.exist?(frameworks_script)
      script = File.read(frameworks_script)
      # Each is guarded on existence because the script runs under `set -e -u`:
      # install_framework leaves `source` unset for a framework that has not been
      # built yet, which aborts the script and silently skips the rest.
      #
      # chmod: Plaid ships LinkKit's binary read-only (-r-xr-xr-x) inside its
      # committed xcframework. rsync preserves that mode, so `codesign --force` on
      # the copy fails with "Permission denied" and takes the whole phase with it.
      additions = spm_frameworks
        .reject { |name| script.include?(%("${BUILT_PRODUCTS_DIR}/#{name}.framework")) }
        .map do |name|
          %(  if [ -d "${BUILT_PRODUCTS_DIR}/#{name}.framework" ]; then\n) +
          %(    chmod -R u+w "${BUILT_PRODUCTS_DIR}/#{name}.framework"\n) +
          %(    install_framework "${BUILT_PRODUCTS_DIR}/#{name}.framework"\n) +
          %(  fi\n)
        end
        .join
      unless additions.empty?
        # Append inside each per-configuration block, before its closing `fi`.
        patched = script.gsub(/^(  install_framework .*\n)(?!  install_framework)/) { "#{$1}#{additions}" }
        File.write(frameworks_script, patched)
      end
    end
    # fmt requires C++17; ReactCommon and all React-* pods require C++20.
    # FOLLY_CFG_NO_COROUTINES=1 must be set globally — folly/coro headers are not
    # shipped in RN's RCT-Folly and any target that transitively includes Optional.h
    # or Expected.h will fail without this flag.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        else
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        end
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        unless config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'].include?('FOLLY_CFG_NO_COROUTINES=1')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_CFG_NO_COROUTINES=1'
        end
        # fmt 11+ uses `consteval` for basic_format_string, which Apple Clang on
        # Xcode 15/16 rejects when consumers (RCT-Folly, ReactCommon) compile under
        # C++20. Force fmt to fall back to `constexpr` so the existing call sites
        # type-check.
        unless config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'].include?('FMT_USE_CONSTEVAL=0')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FMT_USE_CONSTEVAL=0'
        end
      end
    end
  end
end
