# Frame React Native — example app config template.
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# metro.config.js loads .env into process.env at bundle time (zero-dependency
# parser — no react-native-dotenv). App.tsx reads process.env.FRAME_*, so once
# .env is filled in, just run `npm start` — no shell sourcing needed.
# Add `-- --reset-cache` after editing values, since Metro caches inlined vars.
#
# Shell vars override the file, so you can still do:
#
#   FRAME_PUBLISHABLE_KEY=pk_... FRAME_SECRET_KEY=sk_... npm start

# Publishable key (pk_...) — safe to embed in the client.
FRAME_PUBLISHABLE_KEY=

# Secret key (sk_...) — server-side key; only in the example for the legacy
# server-only checkout demo routes. Do not ship in a production client.
FRAME_SECRET_KEY=
