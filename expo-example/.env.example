# Frame React Native — Expo example app config template.
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Expo auto-loads .env and inlines EXPO_PUBLIC_*-prefixed vars into the bundle
# at build time (babel-preset-expo). No metro/babel plugin needed. Once .env is
# filled in, just run the app. Re-run with a cleared cache (`npx expo start -c`)
# after editing values, since Expo caches the inlined vars.
#
# The EXPO_PUBLIC_ prefix is REQUIRED — Expo only exposes prefixed vars to the
# client. To leave the app publishable-key-only, omit the secret key entirely.

# Publishable key (pk_...) — safe to embed in the client.
EXPO_PUBLIC_FRAME_PUBLISHABLE_KEY=

# Secret key (sk_...) — server-side key; optional. Only needed to exercise the
# server-only demo buttons and legacy server-keyed checkout. Do not ship in a
# production client.
EXPO_PUBLIC_FRAME_SECRET_KEY=
